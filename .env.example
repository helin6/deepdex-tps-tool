# BENCH_DURATION_SEC=60                  # 压测时长
# BENCH_START_AT_UNIX_MS=1778666428000   # 各机相同 Unix 毫秒，同时起跑
# CHAIN_SCAN_CONCURRENCY=64              # 链上扫描并发度
# BENCH_PREP_CONCURRENCY=32              # 准备阶段并发度
# BENCH_SKIP_PREP=0                      # 是否跳过准备阶段

# FENCE_POOL_SENDERS=128                 # 栅栏池 worker 数量
# FENCE_THROTTLE_SEC=0                   # 每批 RPC 之后额外睡眠秒数
# FENCE_BURST_SUBMIT=0                   # 设为 1 则关闭批间 1s 节流（尽快灌完）
# FENCE_POST_CHAIN_SCAN_SEC=5          # 发送结束后再等几秒扫链；0 不做链上汇总

# # WS_URL=ws://10.146.0.13:9937
# WS_URL=wss://rpc-testnet.deepx.fi      
# FIRST_ADDR_INDEX=4001                  # 起始地址索引
# ACCOUNT_COUNT=20                       # 账户数量
# RATE=10                                # 发压频率

# 可选环境变量
# RUN_ID=shard-a
# ROOTER_POST_QUOTA_SLEEP_MS=20
# PARALLEL_SUBACCOUNT_INITS=48
# INIT_POLL_FIRST_MS=45
# INIT_POLL_STEP_MS=110
